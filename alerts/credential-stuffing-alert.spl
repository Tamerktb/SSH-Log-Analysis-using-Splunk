###############################################################################
# Credential Stuffing Alert - Saved Search Definition
# MITRE ATT&CK: T1110.004 - Credential Stuffing
#
# Triggers when a single IP attempts 15+ different usernames within 2 minutes.
# Sends alert to SOC via email/Slack/webhook.
###############################################################################

[SSH - Credential Stuffing Detection]
disabled = 0
enableSched = 1
alert_type = always
alert.severity = 4
alert.suppress = 1
alert.suppress.fields = src_ip
alert.suppress.period = 2h
alert.track = 1
counttype = number of events
quantity = 0
relation = greater than
cron_schedule = */2 * * * *
description = Detects SSH credential stuffing attacks - 15+ unique usernames from same IP in 2 minutes
dispatch.earliest_time = -2m
dispatch.latest_time = now
displayview = flashtimeline
is_scheduled = 1
realtime_schedule = 1
request.ui_dispatch_app = search
request.ui_dispatch_view = search
search = index=linux_secure sourcetype=linux_secure "Failed password" \
  | rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)" \
  | stats dc(target_user) as unique_users, count as total_attempts by src_ip \
  | where unique_users >= 15 AND total_attempts >= 20 \
  | lookup geoip src_ip OUTPUT city, country \
  | eval severity = "CRITICAL", alert_type = "credential_stuffing" \
  | table src_ip, unique_users, total_attempts, city, country, severity, alert_type
action.email = 1
action.email.to = soc@example.com
action.email.subject = Splunk Alert: SSH Credential Stuffing from $result.src_ip$
action.email.include = 1
action.email.sendresults = 1
action.email.format = table
action.slack = 1
action.slack.param.channel = #security-alerts
action.slack.param.message = CRITICAL: Credential stuffing attack from $result.src_ip$ - $result.unique_users$ accounts targeted

[SSH - Successful Brute Force Detection]
disabled = 0
enableSched = 1
alert_type = always
alert.severity = 5
alert.suppress = 1
alert.suppress.fields = src_ip
alert.suppress.period = 4h
alert.track = 1
cron_schedule = */10 * * * *
description = Detects successful SSH login after a brute force pattern - possible account compromise
dispatch.earliest_time = -10m
dispatch.latest_time = now
search = index=linux_secure sourcetype=linux_secure \
  | rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)" \
  | eventstats count(eval(match(_raw, "Failed password"))) as fail_count by src_ip, target_user \
  | search "Accepted password" \
  | rex "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)" \
  | where fail_count >= 5 \
  | eval severity = "CRITICAL", alert_type = "brute_force_success", risk_score = fail_count * 10 \
  | table _time, src_ip, target_user, fail_count, risk_score, severity, alert_type
action.email = 1
action.email.to = soc@example.com
action.email.subject = CRITICAL: SSH Breach Detected - $result.src_ip$ compromised $result.target_user$
action.email.include = 1
action.email.sendresults = 1
action.slack = 1
action.slack.param.channel = #security-alerts
action.slack.param.message = CRITICAL: SSH account compromised! $result.target_user$@$result.src_ip$ after $result.fail_count$ failed attempts
