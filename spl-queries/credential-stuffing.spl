###############################################################################
# SSH Credential Stuffing Detection
# MITRE ATT&CK: T1110.004 - Credential Stuffing
#
# Assumes: index=linux_secure sourcetype=linux_secure
# Geo enrichment uses the BUILT-IN `iplocation` command (no external lookup).
###############################################################################

# === Multi-Account Credential Stuffing ===
# One source IP trying many distinct usernames in a short window.
index=linux_secure sourcetype=linux_secure "Failed password"
| rex field=_raw "Failed password for (?:invalid user )?(?<target_user>\S+) from (?<src_ip>\S+) port (?<src_port>\d+)"
| bin _time span=2m
| stats dc(target_user) AS unique_users count AS total_attempts BY src_ip, _time
| where unique_users >= 10 AND total_attempts >= 15
| eval confidence = case(
    unique_users >= 50, "VERY_HIGH",
    unique_users >= 25, "HIGH",
    true(), "MEDIUM"
  )
| eval attack_type = "credential_stuffing"
| sort - unique_users
| table _time, src_ip, unique_users, total_attempts, confidence, attack_type

# === Distributed Credential Stuffing ===
# Multiple source IPs targeting the same account(s) in a coordinated window.
index=linux_secure sourcetype=linux_secure "Failed password"
| rex field=_raw "Failed password for (?:invalid user )?(?<target_user>\S+) from (?<src_ip>\S+)"
| bin _time span=5m
| iplocation src_ip
| stats dc(src_ip) AS unique_sources values(Country) AS source_countries
        values(City) AS source_cities BY target_user, _time
| where unique_sources >= 3
| eval attack_type = "distributed_credential_stuffing"
| sort - unique_sources
| table _time, target_user, unique_sources, source_countries, source_cities, attack_type

# === Slow Credential Stuffing (low-and-slow) ===
# Low attempt rate sustained across many hours to evade burst thresholds.
index=linux_secure sourcetype=linux_secure "Failed password"
| rex field=_raw "Failed password for (?:invalid user )?(?<target_user>\S+) from (?<src_ip>\S+)"
| bin _time span=1h
| stats count AS hourly_attempts BY src_ip, _time
| where hourly_attempts >= 3 AND hourly_attempts < 10
| stats count AS active_hours values(_time) AS pattern_times BY src_ip
| where active_hours >= 6
| eval attack_type = "slow_credential_stuffing"
| sort - active_hours
| table src_ip, active_hours, pattern_times, attack_type

# === Credential Stuffing Followed by Success ===
# Stuffing that resulted in at least one accepted login = likely breach.
index=linux_secure sourcetype=linux_secure ("Failed password" OR "Accepted password")
| rex field=_raw "(?<outcome>Failed password|Accepted password) for (?:invalid user )?(?<target_user>\S+) from (?<src_ip>\S+)"
| eval is_fail    = if(outcome == "Failed password", 1, 0)
| eval is_success = if(outcome == "Accepted password", 1, 0)
| stats sum(is_fail) AS fail_count
        dc(eval(if(is_fail == 1, target_user, null()))) AS users_tried
        sum(is_success) AS success_count BY src_ip
| where fail_count >= 10 AND users_tried >= 5 AND success_count > 0
| eval alert_severity = "CRITICAL", alert_type = "credential_stuffing_breach"
| table src_ip, fail_count, users_tried, success_count, alert_severity, alert_type

# === Cross-Protocol Credential Stuffing (illustrative) ===
# Same source hitting SSH + other service logs with the same username set.
# REQUIRES comparable extraction for each sourcetype (e.g. Splunk_TA_nix for
# linux_secure, a Windows add-on for win_security). Fields are coalesced.
index=* (sourcetype=linux_secure OR sourcetype=apache_error OR sourcetype=mail_log OR sourcetype=win_security)
| eval svc = case(
    match(sourcetype, "linux_secure"), "SSH",
    match(sourcetype, "apache"), "WEB",
    match(sourcetype, "mail"), "EMAIL",
    match(sourcetype, "win_security"), "RDP"
  )
| rex field=_raw "Failed password for (?:invalid user )?(?<target_user>\S+) from (?<src_ip>\S+)"
| rex field=_raw "Invalid user (?<invalid_user>\S+) from (?<invalid_src>\S+)"
| eval user = coalesce(target_user, invalid_user)
| eval src  = coalesce(src_ip, invalid_src)
| where isnotnull(user) AND isnotnull(src)
| bin _time span=15m
| stats dc(svc) AS services_attacked dc(user) AS unique_creds count BY src, _time
| where services_attacked >= 2 AND unique_creds >= 5
| eval attack_type = "cross_protocol_stuffing"
| sort - services_attacked
| table _time, src, services_attacked, unique_creds, count, attack_type
