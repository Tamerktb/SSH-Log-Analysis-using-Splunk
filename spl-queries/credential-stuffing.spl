###############################################################################
# SSH Credential Stuffing Detection
# MITRE ATT&CK: T1110.004 - Credential Stuffing
#
# Detects credential stuffing attacks where attackers use previously
# compromised credentials across multiple accounts or services.
###############################################################################

# === Multi-Account Credential Stuffing ===
# Single source IP trying many different usernames in rapid succession
index=linux_secure sourcetype=linux_secure "Failed password"
| rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+) port (?<src_port>\d+)"
| bucket _time span=2m
| stats dc(target_user) as unique_users, count as total_attempts by src_ip, _time
| where unique_users >= 10 AND total_attempts >= 15
| eval attack_type = "credential_stuffing",
       confidence = case(
           unique_users >= 50, "VERY_HIGH",
           unique_users >= 25, "HIGH",
           unique_users >= 10, "MEDIUM"
       )
| sort - unique_users
| table _time, src_ip, unique_users, total_attempts, confidence, attack_type

# === Distributed Credential Stuffing ===
# Multiple source IPs targeting the same set of usernames (coordinated attack)
index=linux_secure sourcetype=linux_secure "Failed password"
| rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)"
| bucket _time span=5m
| stats dc(src_ip) as unique_sources by target_user, _time
| where unique_sources >= 3
| lookup geoip src_ip OUTPUT city, country
| stats values(city) as source_cities, values(country) as source_countries,
        dc(src_ip) as total_sources by target_user, _time
| where total_sources >= 3
| eval attack_type = "distributed_credential_stuffing"
| sort - total_sources
| table _time, target_user, total_sources, source_cities, source_countries

# === Slow Credential Stuffing (Low-and-Slow) ===
# Low attempt rate over extended period to evade threshold detection
index=linux_secure sourcetype=linux_secure "Failed password"
| rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)"
| bucket _time span=1h
| stats count by src_ip, _time
| where count >= 3 AND count < 10
| stats count as hourly_patterns, values(_time) as pattern_times by src_ip
| where hourly_patterns >= 6
| eval attack_type = "slow_credential_stuffing",
       duration_hours = hourly_patterns
| sort - hourly_patterns
| table src_ip, hourly_patterns, duration_hours, attack_type

# === Credential Stuffing with Success ===
# Detects when a credential stuffing attack results in a successful login
index=linux_secure sourcetype=linux_secure
| rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)"
| eventstats count(eval(match(_raw, "Failed password"))) as fail_count,
            dc(eval(if(match(_raw, "Failed password"), target_user, null()))) as user_count
    by src_ip
| search "Accepted password"
| rex "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| where fail_count >= 10 AND user_count >= 5
| eval alert_severity = "CRITICAL",
       alert_type = "credential_stuffing_breach"
| table _time, src_ip, target_user, fail_count, user_count, alert_severity, alert_type

# === Cross-Protocol Credential Stuffing ===
# Same source IP hitting SSH + other services with same usernames
index=* sourcetype IN (linux_secure, apache_error, mail_log, win_security)
| rex "Failed password for (?<target_user>\S+) from (?<src_ip>\S+)"
| eval service = case(
    match(sourcetype, "linux_secure"), "SSH",
    match(sourcetype, "apache"), "WEB",
    match(sourcetype, "mail"), "EMAIL",
    match(sourcetype, "win_security"), "RDP"
  )
| bucket _time span=15m
| stats dc(service) as services_attacked, dc(target_user) as unique_creds,
        count by src_ip, _time
| where services_attacked >= 2 AND unique_creds >= 5
| eval attack_type = "cross_protocol_stuffing"
| sort - services_attacked
| table _time, src_ip, services_attacked, unique_creds, count, attack_type
