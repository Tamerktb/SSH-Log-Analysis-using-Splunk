###############################################################################
# SSH Anomaly Detection
# MITRE ATT&CK: T1078 - Valid Accounts
#
# Assumes: index=linux_secure sourcetype=linux_secure
# Geo enrichment uses the BUILT-IN `iplocation` command (no external lookup).
###############################################################################

# === Impossible Travel Detection ===
# Same user authenticating from geographically impossible locations.
# FIX: prior version used `streamstats values(lat)` (an aggregate that does
# NOT return the previous event) and referenced an undefined `prev_time`,
# so the filter could never match. This version sorts per user, then uses
# `streamstats current=f window=1 last(...)` to bind the PREVIOUS event.
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| iplocation src_ip
| where isnotnull(lat) AND isnotnull(lon)
| sort 0 target_user +_time
| streamstats current=f window=1
    last(lat)     AS prev_lat
    last(lon)     AS prev_lon
    last(City)    AS prev_city
    last(Country) AS prev_country
    last(_time)   AS prev_time
    BY target_user
| where isnotnull(prev_lat)
| eval distance_km = round(sqrt(pow((lat - prev_lat) * 111.32, 2)
                          + pow((lon - prev_lon) * 111.32 * cos(lat * 3.14159 / 180), 2)), 1)
| eval time_diff_hours = round((_time - prev_time) / 3600, 3)
| eval required_speed_kmh = if(time_diff_hours > 0, round(distance_km / time_diff_hours, 1), null())
| where required_speed_kmh > 900 AND required_speed_kmh < 100000
| eval anomaly_type = "impossible_travel", confidence = "HIGH"
| table _time, target_user, src_ip, City, prev_city, distance_km,
        time_diff_hours, required_speed_kmh, anomaly_type, confidence

# === Off-Hours Login Detection ===
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| eval login_hour = tonumber(strftime(_time, "%H"))
| eval login_dow  = tonumber(strftime(_time, "%u"))
| where login_hour < 7 OR login_hour > 19 OR login_dow >= 6
| iplocation src_ip
| eval is_weekend = if(login_dow >= 6, 1, 0)
| eval risk_score = case(
    is_weekend == 1 AND (login_hour < 6 OR login_hour > 22), 80,
    is_weekend == 1, 60,
    true(), 40
  )
| eval anomaly_type = "off_hours_login"
| sort - risk_score
| table _time, target_user, src_ip, City, Country, login_hour, login_dow,
        is_weekend, risk_score, anomaly_type

# === First-Time Login Detection ===
# A user authenticating from an IP / city never seen before in the window.
# FIX: prior version compared against `eventstats values(...)` which includes
# the CURRENT event, so nothing was ever "new". Uses prior-event history.
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| iplocation src_ip
| sort 0 target_user +_time
| streamstats current=f values(src_ip) AS historical_ips
                          values(City)   AS historical_cities BY target_user
| eval is_new_ip = if(isnull(historical_ips), "true",
                      if(mvcount(mvfilter(historical_ips == src_ip)) == 0, "true", "false"))
| eval is_new_city = if(isnull(historical_cities) OR isnull(City), "false",
                        if(mvcount(mvfilter(historical_cities == City)) == 0, "true", "false"))
| where is_new_ip == "true" OR is_new_city == "true"
| eval anomaly_type = case(
    is_new_ip == "true" AND is_new_city == "true", "new_identity_login",
    is_new_ip == "true", "new_ip_login",
    true(), "new_city_login"
  )
| eval confidence = case(anomaly_type == "new_identity_login", "HIGH", true(), "MEDIUM")
| table _time, target_user, src_ip, City, Country, anomaly_type, confidence

# === Concurrent Session Anomaly ===
index=linux_secure sourcetype=linux_secure
| rex field=_raw "(?<outcome>Accepted|Failed) password for (?<target_user>\S+) from (?<src_ip>\S+)"
| where outcome == "Accepted"
| bin _time span=1m
| stats dc(src_ip) AS active_sessions BY target_user, _time
| where active_sessions >= 3
| eval anomaly_type = "concurrent_session_abuse"
| sort - active_sessions
| table _time, target_user, active_sessions, anomaly_type

# === Statistical Outlier Detection ===
index=linux_secure sourcetype=linux_secure "Failed password"
| bin _time span=1h
| stats count AS hourly_failures BY src_ip, _time
| eventstats avg(hourly_failures) AS avg_failures stdev(hourly_failures) AS stdev_failures BY src_ip
| eval upper_bound = avg_failures + (3 * coalesce(stdev_failures, 0))
| where hourly_failures > upper_bound AND hourly_failures > 10
| eval anomaly_type = "statistical_outlier",
       deviation_factor = round(hourly_failures / (avg_failures + 1), 2)
| sort - deviation_factor
| table _time, src_ip, hourly_failures, avg_failures, stdev_failures,
        deviation_factor, anomaly_type
