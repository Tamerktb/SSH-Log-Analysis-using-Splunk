###############################################################################
# SSH User Behaviour Analytics (UBA)
# MITRE ATT&CK: T1078 - Valid Accounts
#
# Assumes: index=linux_secure sourcetype=linux_secure
# Geo enrichment uses the BUILT-IN `iplocation` command (no external lookup).
###############################################################################

# === User Login Baseline ===
# Flags a user's daily volume or source-IP diversity above their own baseline.
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| bin _time span=1d
| stats count AS daily_logins dc(src_ip) AS unique_ips values(src_ip) AS ip_list BY target_user, _time
| eventstats avg(daily_logins) AS avg_logins stdev(daily_logins) AS stdev_logins BY target_user
| eval upper_normal = avg_logins + (2 * coalesce(stdev_logins, 0))
| where daily_logins > upper_normal OR unique_ips > 3
| eval anomaly = case(
    daily_logins > upper_normal, "login_volume_anomaly",
    true(), "ip_diversity_anomaly"
  )
| sort - daily_logins
| table target_user, _time, daily_logins, avg_logins, unique_ips, anomaly

# === Privileged Account Login Tracking ===
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| where lower(target_user) IN ("root", "toor", "admin", "administrator")
| iplocation src_ip
| stats count AS priv_logins dc(src_ip) AS source_ips
        values(src_ip) AS ips values(City) AS cities BY target_user
| eval risk_score = priv_logins * 15
| sort - risk_score
| table target_user, priv_logins, source_ips, cities, risk_score

# === Account Sharing Detection ===
# Multiple distinct users from the same source IP in a short window.
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+)"
| bin _time span=15m
| stats dc(target_user) AS unique_users values(target_user) AS user_list BY src_ip, _time
| where unique_users >= 3
| eval anomaly_type = "account_sharing", risk_score = unique_users * 20
| sort - unique_users
| table _time, src_ip, unique_users, user_list, risk_score, anomaly_type

# === Session Duration Analysis ===
# Requires session-transaction fields; uses `transaction` on user+src.
index=linux_secure sourcetype=linux_secure
| rex field=_raw "Accepted (?<auth_type>password|publickey) for (?<target_user>\S+) from (?<src_ip>\S+)"
| where isnotnull(auth_type)
| transaction target_user, src_ip maxspan=24h
| eval session_hours = duration / 3600
| where session_hours < 0.01 OR session_hours > 8
| eval anomaly_type = if(session_hours < 0.01, "session_too_short", "session_too_long"),
       risk_score = if(session_hours < 0.01, 30, 50)
| table _time, target_user, src_ip, session_hours, anomaly_type, risk_score

# === Privileged Account Lateral Movement ===
# A privileged user authenticating to multiple hosts in sequence.
index=linux_secure sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<target_user>\S+) from (?<src_ip>\S+) port (?<src_port>\d+) ssh2"
| where lower(target_user) IN ("root", "admin", "deploy", "ansible", "svc_backup")
| transaction target_user maxspan=30m
| eval host_count = mvcount(host), ip_count = mvcount(src_ip)
| where host_count >= 3 OR ip_count >= 3
| eval anomaly_type = "lateral_movement", risk_score = host_count * 25
| sort - risk_score
| table _time, target_user, host_count, ip_count, anomaly_type, risk_score

# === New SSH User Account Creation ===
index=linux_secure sourcetype=linux_secure "New user"
| rex field=_raw "New user (?:name=(?<new_user>\S+)|'(?<new_user>\S+)')"
| eval anomaly_type = "new_account_creation", risk_score = 40
| table _time, new_user, host, anomaly_type, risk_score

# === Sudo / Privilege Escalation via SSH ===
# Audits sudo commands seen in linux_secure (sudo logs to auth.log by default).
index=linux_secure sourcetype=linux_secure "COMMAND="
| rex field=_raw "COMMAND=(?<command>.+)"
| top limit=20 command
| eval anomaly_type = "sudo_command_audit"
| table command, count, percent, anomaly_type
